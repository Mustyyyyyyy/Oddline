# Database credentials for the Docker Compose PostgreSQL container.
POSTGRES_DB=oddline
POSTGRES_USER=oddline
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://oddline:replace-with-a-long-random-password@localhost:5432/oddline
DATABASE_POOL_SIZE=3
# For local Node development, run Compose and use:
# DATABASE_URL=postgresql://oddline:replace-with-a-long-random-password@localhost:5432/oddline

# Set this secret in .env or the host's secret manager. Never commit the real key.
# API-Sports provides Football schedules and available bookmaker odds.
API_SPORTS_KEY=
# Upcoming fixture/odds range. The API-Sports plan controls league and odds availability.
API_SPORTS_DAYS_AHEAD=7
# Cache real fixture/odds responses to conserve provider quota.
SPORTS_FEED_CACHE_SECONDS=21600
REQUIRE_LIVE_PROVIDER=1

# Published website port. Put a TLS-enabled reverse proxy in front of the app.
PORT=8000

# Docker Compose connects to the internal PostgreSQL service via PGHOST/PGPORT.
